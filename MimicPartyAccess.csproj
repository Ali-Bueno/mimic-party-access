<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MimicPartyAccess</AssemblyName>
    <RootNamespace>MimicPartyAccess</RootNamespace>
    <Product>Mimic Party Access</Product>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\games\steam\steamapps\common\Mimic Party</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginDir>$(BepInExDir)\plugins\$(AssemblyName)</PluginDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**;tools\**" />
    <None Remove="tests\**;tools\**" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- BepInEx runtime: reference what is installed, never copy it. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
  </ItemGroup>

  <!-- Game interop assemblies generated by BepInEx (repair them with templates/bepinex-interop-fixer). -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.Localization.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Mimick.Runtime.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="localization\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native\prism.dll" CopyToOutputDirectory="PreserveNewest" Link="prism.dll" Condition="Exists('native\prism.dll')" />
  </ItemGroup>

  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).pdb;$(TargetDir)prism.dll" />
      <DeployLocalization Include="$(TargetDir)localization\**\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginDir)" Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="@(DeployLocalization)" DestinationFiles="@(DeployLocalization->'$(PluginDir)\localization\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
